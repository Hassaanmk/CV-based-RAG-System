# ---------------------------------------------------------------------------
# Provider selection (all defaults have a free, no-credit-card tier)
# ---------------------------------------------------------------------------
# LLM_PROVIDER:    gemini | groq          RERANK_PROVIDER: jina | none
# EMBED_PROVIDER:  jina   | local
LLM_PROVIDER=gemini
EMBED_PROVIDER=jina
RERANK_PROVIDER=jina

# Optional model overrides. Defaults:
#   gemini -> gemini-2.5-flash          groq  -> llama-3.3-70b-versatile
#   jina   -> jina-embeddings-v2-base-en
#   local  -> sentence-transformers/all-MiniLM-L6-v2
# LLM_MODEL=
# EMBED_MODEL=

# ---------------------------------------------------------------------------
# API keys — only the ones your selected providers need
# ---------------------------------------------------------------------------
# Google AI Studio — Gemini free tier, ~15 req/min, no card.
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq — free tier, 30 req/min, no card. Needed only if LLM_PROVIDER=groq.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Jina AI — free trial tokens for embeddings + reranking, no card.
# Needed if EMBED_PROVIDER=jina or RERANK_PROVIDER=jina.
# Get one at: https://jina.ai/api-dashboard/
JINA_API_KEY=your_jina_api_key_here
